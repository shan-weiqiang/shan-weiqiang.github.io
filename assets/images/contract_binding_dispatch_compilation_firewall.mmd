flowchart TB
  consumer["Consumer"]
  contract["Stable binary contract<br/>1. stable symbol, signature, and calling rules<br/>2. stable size, alignment, and layout of exposed types"]
  firewall["Compilation firewall<br/>consumer compilation stops at the contract"]

  pimpl["PImpl facade<br/>fixed forwarding through an opaque pointer<br/>no runtime implementation selection"]
  hiddenImpl["Hidden Impl"]

  runtime["Runtime binding data<br/>plus fixed dispatch instructions"]
  selectedImpl["Runtime-selected<br/>concrete implementation"]

  consumer -->|"compiles against"| contract
  contract -.->|"creates"| firewall
  contract --> pimpl
  pimpl -->|"direct or fixed forwarding"| hiddenImpl
  contract --> runtime
  runtime -->|"indirect dispatch"| selectedImpl
